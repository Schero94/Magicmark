{
  "version": "3.4.0",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "bookmarks",
    "query-builder",
    "content-manager",
    "filters",
    "productivity",
    "admin-panel"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist/",
    "strapi-server.js",
    "README.md",
    "LICENSE",
    "COPYRIGHT_NOTICE.txt",
    "pics/"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "tsc --noEmit -p admin/tsconfig.json",
    "test:ts:back": "tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@types/qs": "^6.14.0",
    "qs": "^6.14.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.57.0",
    "@strapi/typescript-utils": "^5.57.0",
    "vite": "^6.4.4",
    "@swc/core": "^1.13.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.1",
    "semantic-release": "^25.0.9",
    "styled-components": "^6.1.19",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.6.2",
    "react-router-dom": "^6.30.1",
    "styled-components": "^6.1.19"
  },
  "strapi": {
    "kind": "plugin",
    "name": "magic-mark",
    "displayName": "MagicMark - Query Builder",
    "description": "Save and apply complex Content Manager queries with one click. Advanced bookmark management with role-based sharing."
  },
  "name": "strapi-plugin-magic-mark",
  "description": "Advanced Query Builder and Bookmark Manager for Strapi v5 - Save complex Content Manager filters with one click",
  "license": "MIT",
  "private": false,
  "author": "Schero D.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Schero94/Magicmark.git"
  },
  "bugs": {
    "url": "https://github.com/Schero94/Magicmark/issues"
  },
  "homepage": "https://github.com/Schero94/Magicmark#readme"
}
