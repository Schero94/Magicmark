{
  "version": "3.4.0",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "bookmarks",
    "query-builder",
    "content-manager",
    "filters",
    "productivity",
    "admin-panel"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "strapi-admin.js",
    "strapi-server.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "node --test tests/*.test.cjs",
    "test:ts:front": "tsc --noEmit -p admin/tsconfig.json",
    "test:ts:back": "tsc --noEmit -p server/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run clean && strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "verify:runtime": "node scripts/verify-runtime.cjs",
    "prepublishOnly": "npm test && npm run build && npm run verify && npm run verify:runtime"
  },
  "dependencies": {
    "qs": "^6.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "5.61.0",
    "@strapi/typescript-utils": "5.61.0",
    "@strapi/utils": "5.61.0",
    "@types/qs": "^6.15.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "semantic-release": "^25.0.9",
    "styled-components": "^6.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.0.0",
    "@strapi/utils": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "magic-mark",
    "displayName": "Magic Mark",
    "description": "Save Content Manager list views with their filters as bookmarks and share them with roles and users."
  },
  "name": "strapi-plugin-magic-mark",
  "description": "Bookmarks and advanced filters for the Strapi 5 Content Manager: save list views, share them with roles and users. Free and open source.",
  "license": "MIT",
  "private": false,
  "author": "Schero D.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Schero94/Magicmark.git"
  },
  "bugs": {
    "url": "https://github.com/Schero94/Magicmark/issues"
  },
  "homepage": "https://github.com/Schero94/Magicmark#readme",
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "npm": ">=6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
